CREATE TABLE alumno ( 
    matricula  INTEGER      NOT NULL, 
    cedula     VARCHAR(15)  NOT NULL, 
    nombre     VARCHAR(40)  NOT NULL, 
    carrera    VARCHAR(30)  NOT NULL, 
    estado     VARCHAR(10)  NOT NULL 
); 
  
INSERT INTO alumno 
SELECT n, 
       (3000000 + n)::text, 
       'Alumno de prueba numero ' || n, 
       (ARRAY['Informatica','Civil', 
              'Electronica','Industrial'])[1 + n % 4], 
       'Activo' 
FROM generate_series(1, 1000000) AS n; 
  
ANALYZE alumno;   -- actualiza las estadísticas de la tabla
